NEXT_PUBLIC_LINERFY_API_BASE_URL=
# Do NOT persist this. It gates destructive/test-only writes (--reset and the
# fixture) and must be set inline on that one command only:
#   LINERFY_RESET_ALLOWED=1 python -m linerfy_ingest --fixture
LINERFY_RESET_ALLOWED=
# Grants DB integration tests permission to run against DATABASE_URL, in
# addition to a database marked by `--prepare-test-db`. Set inline for the test
# run only:  LINERFY_DB_TESTS_ALLOWED=1 uv run pytest
LINERFY_DB_TESTS_ALLOWED=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Model provider (DeepSeek, OpenAI-compatible) for the summary step.
MODEL_API_KEY=
# The Guardian Content API key, used by `--guardian`.
GUARDIAN_API_KEY=
