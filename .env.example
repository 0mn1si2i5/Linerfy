# Server-side Supabase. The service role key is server-only; it is never
# shipped to a browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side Supabase auth (the OAuth sign-in page uses these, not the
# service role key). The publishable (anon) key can authenticate but cannot
# read the catalog: anonymous reads are removed at the database layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Numeric GitHub ids allowed to read the catalog, comma-separated. An empty or
# missing value denies everyone (fail-closed).
LINERFY_ALLOWED_GITHUB_IDS=

# Do NOT persist this. It gates destructive/test-only writes (--reset and the
# fixture) and must be set inline on that one command only:
#   LINERFY_RESET_ALLOWED=1 python -m linerfy_ingest --fixture
LINERFY_RESET_ALLOWED=
# Grants DB integration tests permission to run against DATABASE_URL, in
# addition to a database marked by `--prepare-test-db`. Set inline for the test
# run only:  LINERFY_DB_TESTS_ALLOWED=1 uv run pytest
LINERFY_DB_TESTS_ALLOWED=

# Model provider for the summary step. `MODEL_PROTOCOL` is one of
# `openai-compatible` (DeepSeek/OpenAI) or `anthropic` (Claude). Only one
# provider is active at a time; there is no automatic fallback.
MODEL_PROTOCOL=openai-compatible
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_MAX_TOKENS=2048
# Where the pre-launch usage budget is recorded (default ~/.linerfy/model-budget.json).
MODEL_BUDGET_PATH=

# The Guardian Content API key, used by `--guardian` (legacy, default-off).
GUARDIAN_API_KEY=
